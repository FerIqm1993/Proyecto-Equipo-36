    {
      "parameters": {
        "jsCode": "// WF3 v1.2 — Snapshot acumulado de curación + nuevos del día (UTC)\nconst rows = $input.all().map(i => i.json);\nconst hoy = new Date().toISOString().slice(0, 10);\n\nlet total = 0;\nlet pendientes = 0, aprobados = 0, rechazados = 0;\nlet almacenadoOci = 0, pendienteOci = 0, errorOci = 0, dryRun = 0;\nlet decisionInvalida = 0, noVerificada = 0;\nlet linkedin = 0, faq = 0, newsletter = 0;\nlet sumaScore = 0, conScore = 0;\nlet nuevosHoy = 0;\nconst executions = new Set();\n\nfor (const r of rows) {\n  const decision = String(r.decision || \"\").toLowerCase().trim();\n  const proceso = String(r.estado_proceso || \"\").toLowerCase().trim();\n  const tipo = String(r.tipo_activo || \"\").toLowerCase().trim();\n\n  total++;\n\n  if (decision === \"pendiente\" || proceso === \"pendiente_decision\") pendientes++;\n  if (decision === \"aprobado\") aprobados++;\n  if (decision === \"rechazado\") rechazados++;\n\n  if (proceso === \"almacenado_oci\") almacenadoOci++;\n  if (proceso === \"pendiente_oci\") pendienteOci++;\n  if (proceso === \"error_oci\") errorOci++;\n  if (proceso === \"put_desactivado_dry_run\") dryRun++;\n  if (proceso === \"decision_invalida\") decisionInvalida++;\n  if (proceso === \"respuesta_oci_no_verificada\") noVerificada++;\n\n  if (tipo === \"linkedin\") linkedin++;\n  else if (tipo === \"faq\") faq++;\n  else if (tipo === \"newsletter\") newsletter++;\n\n  // Fix #4: score vacío NO cuenta como 0\n  const raw = r.score_final;\n  if (raw !== null && raw !== undefined && String(raw).trim() !== \"\") {\n    const sc = Number(raw);\n    if (Number.isFinite(sc)) {\n      sumaScore += sc;\n      conScore++;\n    }\n  }\n\n  if (r.execution_id) executions.add(String(r.execution_id));\n\n  // Fix #1: timestamp_ingesta (si existiera) || timestamp de la fila de curación\n  const ts = String(r.timestamp_ingesta || r.timestamp || \"\");\n  if (ts.startsWith(hoy)) nuevosHoy++;\n}\n\nreturn [{\n  json: {\n    fecha: hoy,\n    total_activos: total,\n    pendientes,\n    aprobados,\n    rechazados,\n    almacenado_oci: almacenadoOci,\n    pendiente_oci: pendienteOci,\n    error_oci: errorOci,\n    put_desactivado_dry_run: dryRun,\n    decision_invalida: decisionInvalida,\n    respuesta_oci_no_verificada: noVerificada,\n    linkedin,\n    faq,\n    newsletter,\n    score_promedio: conScore ? Number((sumaScore / conScore).toFixed(2)) : 0,\n    execution_ids_distintos: executions.size,\n    nuevos_activos_hoy: nuevosHoy,\n    generado_at: new Date().toISOString()\n  }\n}];"
      },
