    {
      "parameters": {
        "jsCode": "// WF3 v1.2 — Snapshot de descartes por motivo (acumulado + del día)\nconst items = $input.all();\nconst rows = items\n  .map(i => i.json)\n  .filter(r => r && (r.motivo_descarte || r.estado || r.interaction_id || r.execution_id));\n\nconst hoy = new Date().toISOString().slice(0, 10);\n\nconst contadores = {\n  total_descartes: rows.length,\n  tipo_no_elegible: 0,\n  sentimiento_no_positivo: 0,\n  score_bajo: 0,\n  error_analisis: 0,\n  fallo_generacion: 0,\n  otro: 0\n};\nlet descartesHoy = 0;\n\nfor (const r of rows) {\n  const m = String(r.motivo_descarte || \"\").toLowerCase().trim();\n  const estado = String(r.estado || \"\").toLowerCase().trim();\n\n  if (m === \"tipo_no_elegible\") contadores.tipo_no_elegible++;\n  else if (m === \"sentimiento_no_positivo\") contadores.sentimiento_no_positivo++;\n  else if (m === \"score_bajo\") contadores.score_bajo++;\n  else if (m === \"error_analisis\") contadores.error_analisis++;\n  else if (\n    m === \"error_generacion\" ||\n    estado === \"descartado_por_generacion\" ||\n    m.includes(\"linkedin_sin\") ||\n    m.includes(\"faq_sin\") ||\n    m.includes(\"newsletter_sin\")\n  ) {\n    contadores.fallo_generacion++;\n  } else if (rows.length > 0) {\n    contadores.otro++;\n  }\n\n  const creado = String(r.createdAt || r.timestamp || \"\");\n  if (creado.startsWith(hoy)) descartesHoy++;\n}\n\nreturn [{\n  json: {\n    fecha: hoy,\n    ...contadores,\n    descartes_hoy: descartesHoy,\n    generado_at: new Date().toISOString()\n  }\n}];"
      },
