    {
      "parameters": {
        "jsCode": "const all = $input.all();\n\n// Asigna row_number ANTES de filtrar (fila 1 = headers → datos desde fila 2)\nconst rows = all.map((item, idx) => {\n  const r = item.json || {};\n  const rowNumber = r.row_number ?? r.rowNumber ?? r.__rowNum__ ?? (idx + 2);\n  return {\n    ...r,\n    row_number: Number(rowNumber),\n    _skip: false\n  };\n});\n\nconst pendientes = rows.filter(r => {\n  const decision = String(r.decision || \"\").toLowerCase().trim();\n  const proceso = String(r.estado_proceso || \"\").toLowerCase().trim();\n\n  // Sin decisión → fuera (aún no curado)\n  if (!decision) return false;\n\n  // Pendiente explícito → fuera (esperando al curador, NO es inválido)\n  if (decision === \"pendiente\") return false;\n\n  // Ya cerrados → fuera (idempotencia, no reprocesar)\n  if ([\"almacenado_oci\", \"cerrado_rechazado\"].includes(proceso)) return false;\n\n  // Todo lo demás pasa: aprobado, rechazado, y TYPOS (aprovado, etc.)\n  // → el Switch decidirá; los typos caen a la rama \"decisión inválida\"\n  return true;\n});\n\nif (pendientes.length === 0) {\n  return [{ json: { _skip: true, mensaje: \"Sin decisiones nuevas\" } }];\n}\n\nreturn pendientes.map(r => ({ json: r }));"
      },
