    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Dry-run: PAR_BASE = \"\"\n// Con PAR: pega URL que termine en /o/\nconst PAR_BASE = \"https://objectstorage.sa-saopaulo-1.oraclecloud.com/p/SWqrKsMINlrIcljYtY-AwmK5_E6aKqxmp-8JHrfR2XpiDOXnG5MqTzgqweFEaR1C/n/grslzqluxaia/b/communitylab-activos-marketing/o/\";\n\nconst item = $input.item.json;\nconst assetId = item.asset_id || \"asset-unknown\";\nconst executionId = item.execution_id || \"exec-unknown\";\nconst rutaObjeto = `activos/aprobados/${executionId}/${assetId}.json`;\n\nlet urlPar = \"\";\nif (PAR_BASE) {\n  const base = PAR_BASE.endsWith(\"/\") ? PAR_BASE : PAR_BASE + \"/\";\n  urlPar = `${base}${rutaObjeto}`;\n}\n\nconst paquete = {\n  execution_id: executionId,\n  asset_id: assetId,\n  interaction_id: item.interaction_id,\n  tipo_activo: item.tipo_activo,\n  autor: item.autor,\n  score_final: item.score_final,\n  contenido: item.contenido,\n  contenido_json: item.contenido_json,\n  decision: item.decision,\n  user: item.user,\n  decision_at: item.decision_at,\n  comentario: item.comentario,\n  almacenado_at: new Date().toISOString()\n};\n\nreturn {\n  json: {\n    ...item,\n    row_number: item.row_number,\n    paquete_oci: paquete,\n    ruta_objeto: rutaObjeto,\n    url_par: urlPar\n  }\n};"
      },
