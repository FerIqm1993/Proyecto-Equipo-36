      "id": "10216dea-b3d4-453a-8d67-a1a65b840db6",
      "name": "PUT a OCI (Object Storage)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Verificación honesta del resultado del PUT a OCI.\n// Requiere Full Response activado en el nodo PUT (Options → Response → Full Response),\n// para que resp.statusCode esté disponible.\nconst prev = $('Preparar Paquete OCI').item.json;\nconst resp = $input.item.json;\n\n// Señal 1: PUT corrió y falló (n8n agrega campo error con onError: continue)\nconst putFallo = Boolean(resp.error);\n\n// Señal 2: PUT desactivado (passthrough) — el item conserva los campos del nodo anterior\nconst putDesactivado =\n  resp.paquete_oci !== undefined || resp.url_par !== undefined;\n\n// Señal 3: código HTTP real (solo existe con Full Response)\nconst statusCode =\n  resp.statusCode ??\n  (resp.response?.statusCode !== undefined ? resp.response.statusCode : undefined);\n\nlet estadoProceso;\nlet errorOci = \"\";\n\nif (putFallo) {\n  // El PUT corrió y Oracle/la red lo rechazó\n  estadoProceso = \"error_oci\";\n  errorOci = String(resp.error).slice(0, 200);\n\n} else if (putDesactivado) {\n  // El nodo está apagado — nada se subió (dry-run honesto)\n  estadoProceso = \"put_desactivado_dry_run\";\n  errorOci = \"PUT desactivado: no se confirmó carga a OCI.\";\n\n} else if (statusCode === undefined) {\n  // Corrió pero no tenemos código verificable — no asumir éxito\n  estadoProceso = \"respuesta_oci_no_verificada\";\n  errorOci = \"Sin statusCode en la respuesta: verificar Full Response en el nodo PUT.\";\n\n} else if ([200, 201].includes(Number(statusCode))) {\n  // Éxito VERIFICADO: Oracle confirmó con 200/201\n  estadoProceso = \"almacenado_oci\";\n\n} else {\n  // Código inesperado (401, 404, 500...) — no fue éxito\n  estadoProceso = \"error_oci\";\n  errorOci = `HTTP ${statusCode} inesperado del PUT a OCI.`;\n}\n\nreturn {\n  json: {\n    row_number: prev.row_number,\n    asset_id: prev.asset_id,\n    execution_id: prev.execution_id,\n    decision: prev.decision,\n    estado_proceso: estadoProceso,\n    estado: \"aprobado\",\n    ruta_objeto: prev.ruta_objeto || \"\",\n    oci_ok: estadoProceso === \"almacenado_oci\",\n    error_oci: errorOci\n  }\n};"
      },
